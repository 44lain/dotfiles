#!/usr/bin/env bash
# rice — the dotfiles control command. A thin router; the real work is in
# rice-apply and rice-rollback (see docs/track-E.md §3).
set -euo pipefail

# Resolve our own directory and prepend it to PATH so rice-apply/rice-rollback
# resolve even before ~/.local/bin is on PATH (fresh machine, first invocation
# via an absolute path, before .bashrc.d/10-path.sh has run).
self_dir=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)
PATH=$self_dir:$PATH

usage() {
	cat <<'EOF'
usage: rice <command>

  apply            preview, back up, confirm, then chezmoi apply
  diff             chezmoi diff (read-only preview)
  rollback [<ts>]  undo the last apply only (newest backup, or a timestamp)
  uninstall        undo every apply ever run here, back to before rice
  onboard          first-machine setup wizard
  doctor           health check
  tui              guided installer (terminal UI)
EOF
}

cmd=${1:-}
if [ "$#" -gt 0 ]; then shift; fi

case $cmd in
	apply)
		exec rice-apply "$@" ;;
	rollback)
		exec rice-rollback "$@" ;;
	uninstall)
		exec rice-uninstall "$@" ;;
	diff)
		exec chezmoi diff "$@" ;;
	onboard)
		if command -v rice-onboard >/dev/null 2>&1; then
			exec rice-onboard "$@"
		fi
		echo "rice onboard: rice-onboard not found on PATH (is ~/.local/bin on PATH? open a new terminal)" >&2
		exit 1 ;;
	doctor)
		exec rice-doctor "$@" ;;
	tui)
		src=$(chezmoi source-path 2>/dev/null) || { echo "rice tui: 'chezmoi source-path' failed (is chezmoi initialised?)" >&2; exit 1; }
		[ -f "$src/installer/__main__.py" ] || { echo "rice tui: installer not found in $src" >&2; exit 1; }
		PYTHONPATH=$src exec python3 -m installer "$@" ;;
	help|-h|--help)
		usage
		exit 0 ;;
	"")
		# an interactive terminal opens the guided installer; anything else keeps the old usage output
		if [ -t 0 ] && [ -t 1 ]; then exec "$0" tui; fi
		usage >&2
		exit 2 ;;
	*)
		echo "rice: unknown command '$cmd'" >&2
		usage >&2
		exit 2 ;;
esac
