#!/usr/bin/env bash
# rice-doctor — health check (track B1, docs/ROADMAP.md). Read-only: never
# mutates the environment. Groups: configs parse, dependencies, services up, fonts
# present, theme coherent. FAIL -> exit 1; WARN is informational only.
set -uo pipefail

fail=0
ok()   { printf '  ok   %s\n' "$1"; }
warn() { printf '  WARN %s\n' "$1"; }
bad()  { printf '  FAIL %s\n' "$1"; fail=1; }
have() { command -v "$1" >/dev/null 2>&1; }
HYPRLAND_MIN=0.55  # oldest Hyprland hyprland.lua is verified against (docs/dependencies.md)

# os_family — keep identical to the copy in executable_rice-onboard
# (test/packages.sh checks it). RICE_OS_RELEASE is a test hook.
os_family() {
	local f=${RICE_OS_RELEASE:-/etc/os-release} id="" like="" k v w
	[ -r "$f" ] || { echo unknown; return; }
	while IFS='=' read -r k v; do
		v=${v//\"/}
		case $k in ID) id=$v ;; ID_LIKE) like=$v ;; esac
	done < "$f"
	for w in $id $like; do
		case $w in
			fedora|rhel) echo fedora; return ;;
			debian|ubuntu) echo debian; return ;;
			arch) echo arch; return ;;
		esac
	done
	echo unknown
}

# apt_lookup <pkg> — asks apt's local cache (read-only, no network, no root)
# for the newest version any configured source offers. Sets APT_BEST and
# APT_FLAG ("-t <suite>" when the newest is not the default candidate, e.g.
# Debian/Parrot backports). Returns 1 when apt knows no version at all.
apt_lookup() {
	local pkg=$1 ver rest s cand suite=""
	APT_BEST=""; APT_FLAG=""
	have apt-cache || return 1
	# madison line: " pkg | version | https://host/path suite/component arch Packages"
	while IFS='|' read -r _ ver rest; do
		ver=${ver//[[:space:]]/}
		[ -n "$ver" ] || continue
		case $rest in *dpkg/status*) continue ;; esac
		s=$(awk '{print $2}' <<<"$rest"); s=${s%%/*}
		if [ -z "$APT_BEST" ]; then
			APT_BEST=$ver; suite=$s
		elif [ "$ver" != "$APT_BEST" ] && [ "$(printf '%s\n%s\n' "$APT_BEST" "$ver" | sort -V | tail -1)" = "$ver" ]; then
			APT_BEST=$ver; suite=$s
		fi
	done < <(apt-cache madison "$pkg" 2>/dev/null)
	[ -n "$APT_BEST" ] || return 1
	cand=$(apt-cache policy "$pkg" 2>/dev/null | sed -n 's/^ *Candidate: //p')
	[ "$cand" = "$APT_BEST" ] || APT_FLAG="-t $suite"
	return 0
}

# --- package data (.chezmoidata/packages.toml via chezmoi) -------------------
family=$(os_family)
case $family in
	fedora) inst="sudo dnf install" ;;
	debian) inst="sudo apt install" ;;
	arch)   inst="sudo pacman -S" ;;
	*)      inst="" ;;
esac
rows=""; data_failed=""
if have chezmoi && have jq; then
	if raw=$(chezmoi data --format=json 2>/dev/null) && rows=$(jq -r --arg fam "$family" '
		(.packages // {}) | to_entries[] | .value as $p
		| [.key, ($p.desc // ""), ($p.bin // ""), (($p.required // false) | tostring),
		   ($p[$fam] // ""), ($p["note_" + $fam] // ""), ($p.manual // ""), ($p.min_version // "")]
		| join("\u001f")' <<<"$raw" 2>/dev/null); then
		:
	else
		data_failed=1
	fi
else
	data_failed=1
fi

# too_old_hint — Hyprland is installed but older than HYPRLAND_MIN: print what
# to install, using the same rules as the missing-package path below.
too_old_hint() {
	local key desc bin required pkg note manual minv flag=""
	while IFS=$'\037' read -r key desc bin required pkg note manual minv; do
		[ "$bin" = Hyprland ] || continue
		if [ -n "$pkg" ] && [ "$family" = debian ]; then
			if ! apt_lookup "$pkg"; then
				printf '       note: apt knows no '"'%s'"' — run '"'sudo apt update'"' first; if it stays empty, the repositories enabled on this system do not carry it (see the notes below and docs/dependencies.md)\n' "$pkg"
				pkg=""
			elif [ "$(printf '%s\n%s\n' "$HYPRLAND_MIN" "$APT_BEST" | sort -V | head -1)" != "$HYPRLAND_MIN" ]; then
				printf '       note: the newest version apt knows is %s, but %s or newer is needed — see docs/dependencies.md\n' "$APT_BEST" "$HYPRLAND_MIN"
				pkg=""
			else
				flag=${APT_FLAG:+ $APT_FLAG}
			fi
		fi
		[ -z "$inst" ] || [ -z "$pkg" ] || printf '       %s%s %s\n' "$inst" "$flag" "$pkg"
		[ -z "$note" ] || printf '       note: %s\n' "$note"
		{ [ -n "$pkg" ] || [ -z "$manual" ]; } || printf '       note: %s\n' "$manual"
		return
	done <<<"$rows"
	echo "       see docs/dependencies.md"
}

echo "== configs parse =="
if have chezmoi && src=$(chezmoi source-path 2>/dev/null) && [ -n "$src" ]; then
	# .chezmoi.*.tmpl (e.g. .chezmoi.toml.tmpl) is chezmoi's own init-time
	# config, not a managed dotfile — it uses promptStringOnce, which only
	# exists under `chezmoi init`, so execute-template can't render it here.
	while IFS= read -r -d '' tmpl; do
		rel=${tmpl#"$src"/}
		if out=$(chezmoi execute-template -f "$tmpl" 2>&1); then
			ok "template renders: $rel"
		else
			bad "template renders: $rel -- ${out##*$'\n'}"
		fi
	done < <(find "$src" -name '*.tmpl' ! -name '.chezmoi.*' ! -path "$src/docs/*" -print0 2>/dev/null)
else
	bad "chezmoi source-path failed"
fi

if have Hyprland; then
	ver=$(Hyprland --version 2>/dev/null | grep -oE '[0-9]+\.[0-9]+(\.[0-9]+)?' | head -1)
	if [ -z "$ver" ]; then
		warn "could not read the Hyprland version"
	elif [ "$(printf '%s\n%s\n' "$HYPRLAND_MIN" "$ver" | sort -V | head -1)" = "$HYPRLAND_MIN" ]; then
		ok "Hyprland $ver (needs $HYPRLAND_MIN or newer)"
	else
		bad "Hyprland $ver is older than $HYPRLAND_MIN — hyprland.lua needs a newer Hyprland"
		too_old_hint
	fi
	if out=$(Hyprland --verify-config 2>&1); then
		ok "Hyprland --verify-config"
	else
		bad "Hyprland --verify-config -- ${out##*$'\n'}"
	fi
else
	warn "Hyprland not on PATH, skipping --verify-config"
fi

echo "== dependencies =="
if [ -n "$data_failed" ]; then
	warn "cannot check dependencies: jq/chezmoi missing or chezmoi data failed"
elif [ -z "$rows" ]; then
	ok "no package data to check (.chezmoidata/packages.toml)"
else
	total=0; missing=0
	declare -A by_flag=()   # key: R|<flag> (required) or O|<flag> (optional)
	extra=()
	while IFS=$'\037' read -r key desc bin required pkg note manual minv; do
		[ -n "$bin" ] || continue
		total=$((total + 1))
		have "$bin" && continue
		missing=$((missing + 1))
		if [ "$required" = true ]; then
			bad "missing (required): $key ($bin) — $desc"
		else
			warn "missing: $key ($bin) — $desc"
		fi
		flag=""
		if [ -n "$pkg" ] && [ "$family" = debian ]; then
			if apt_lookup "$pkg"; then
				flag=$APT_FLAG
				if [ -n "$minv" ] && [ "$(printf '%s\n%s\n' "$minv" "$APT_BEST" | sort -V | head -1)" != "$minv" ]; then
					extra+=("$key: the newest version apt knows is $APT_BEST, but $minv or newer is needed — see docs/dependencies.md")
					pkg=""
				fi
			else
				extra+=("$key: apt knows no '$pkg' — run 'sudo apt update' first; if it stays empty, the repositories enabled on this system do not carry it — a backports or other repository may (see the notes below and docs/dependencies.md)")
				pkg=""
			fi
		fi
		grp=O; [ "$required" != true ] || grp=R
		[ -z "$pkg" ] || by_flag["$grp|${flag:-plain}"]+=" $pkg"
		[ -z "$note" ] || extra+=("$key: $note")
		{ [ -n "$pkg" ] || [ -z "$manual" ]; } || extra+=("$key: $manual")
	done <<<"$rows"
	if [ "$missing" -eq 0 ]; then
		ok "all $total checked dependencies present"
	else
		if [ -n "$inst" ]; then
			# required packages first, optional ones on their own line(s)
			for grp in R O; do
				for k in "${!by_flag[@]}"; do
					[ "${k%%|*}" = "$grp" ] || continue
					f=${k#*|}; [ "$f" = plain ] && f="" || f=" $f"
					lead="      "; [ "$grp" = O ] && lead="  (optional)"
					printf '     %s %s%s%s\n' "$lead" "$inst" "$f" "${by_flag[$k]}"
				done
			done
		else
			echo "       distro not recognised — install the tools above with your package manager"
		fi
		if [ "${#extra[@]}" -gt 0 ]; then
			for i in "${!extra[@]}"; do printf '       note: %s\n' "${extra[$i]}"; done
		fi
	fi
fi

echo "== services up =="
if have pgrep && pgrep -f 'qs -p.*grootshell' >/dev/null 2>&1; then
	ok "grootshell (qs) running"
else
	bad "grootshell (qs) not running"
fi
if have pgrep && pgrep -x hypridle >/dev/null 2>&1; then
	ok "hypridle running"
else
	bad "hypridle not running"
fi
# Services retired from autostart (see hyprland.lua) that shouldn't linger
# from an old systemd --user enable. Add to this list as more get retired.
retired_services="mako.service"
if have systemctl; then
	for svc in $retired_services; do
		if systemctl --user is-active --quiet "$svc" 2>/dev/null; then
			warn "$svc is active (retired from autostart)"
		fi
	done
fi

echo "== fonts present =="
if have fc-list; then
	fonts=$(fc-list)
	for font in "Material Symbols Rounded" "Rubik" "CaskaydiaCove Nerd Font Mono"; do
		if grep -qiF "$font" <<<"$fonts"; then
			ok "font: $font"
		else
			bad "font missing: $font — see the Fonts section of docs/dependencies.md"
		fi
	done
else
	warn "fc-list not on PATH, skipping font checks"
fi

echo "== theme coherent =="
wallpaper_path=""
if have chezmoi && have jq; then
	wallpaper_path=$(chezmoi data --format=json 2>/dev/null | jq -r '.wallpaper_path // empty' 2>/dev/null || true)
fi
if [ -z "$wallpaper_path" ]; then
	ok "wallpaper_path not set (optional — hyprlock uses a solid background)"
elif [ -f "$wallpaper_path" ]; then
	ok "wallpaper_path exists: $wallpaper_path"
else
	bad "wallpaper_path set but missing: $wallpaper_path"
fi

for f in "$HOME/.config/hypr/colors-grootshell.lua" "$HOME/.config/kitty/colors-grootshell.conf"; do
	if [ -s "$f" ]; then
		ok "generated theme file present: $f"
	else
		warn "generated theme file missing (ok before the first theme regenerate): $f"
	fi
done

exit $fail
