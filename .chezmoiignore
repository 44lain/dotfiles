# chezmoi ignores source entries whose name starts with "." automatically
# (.git, .github, .gitignore), so they need no entry here.

# --- repo meta -----------------------------------------------------------
README.md
LICENSE
Makefile
/docs
/test

# --- machine-local -----------------------------------------------------
# user.email lives here, created per machine, never in the repo. See
# docs/track-E.md.
.config/git/local

# --- Stow packages not yet migrated ----------------------------------
# These directories are still in the Stow layout (pkg/.config/...), which
# chezmoi would otherwise map to junk targets like ~/cursor. Each task/wave
# deletes its line here when it converts the package to dot_ layout.
/cursor
/kde
/konsole

# --- hypr files not yet templated (personal wallpaper path) ------------
# Untracked (see .gitignore), but chezmoi reads the filesystem directly so
# they still need hiding here or they'd become junk targets under
# ~/.config/hypr. wave 3 stopped at machine.lua; wallpaper templating is a
# separate follow-up (docs/track-E.md status table).
.config/hypr/hyprlock.conf
.config/hypr/hyprpaper.conf
.config/hypr/colors-grootshell.lua

# --- layer 3 — personal, withheld from guest installs (docs/track-E.md §2) -
# .chezmoiignore is always template-evaluated by chezmoi, no .tmpl suffix
# needed. A guest profile never sees these paths in `chezmoi managed`,
# `chezmoi diff`, or their $HOME.
{{ if ne .profile "personal" -}}
.local/bin/accela
{{ end -}}
