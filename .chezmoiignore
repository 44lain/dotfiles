# chezmoi ignores source entries whose name starts with "." automatically
# (.git, .github, .gitignore), so they need no entry here.

# --- repo meta -----------------------------------------------------------
README.md
LICENSE
Makefile
docs
test

# --- machine-local -----------------------------------------------------
# user.email lives here, created per machine, never in the repo. See
# docs/track-E.md.
.config/git/local

# --- hypr generated output (matugen, not chezmoi) -----------------------
# Untracked (see .gitignore), but chezmoi reads the filesystem directly so
# it still needs hiding here or it'd become a junk target under
# ~/.config/hypr. Regenerated live by matugen on every wallpaper/theme
# change — tracking it in chezmoi would fight that pipeline (permanent
# diff, or rice apply reverting the current palette). hyprlock.conf and
# hyprpaper.conf were the same shape until wave 4 templated them
# (dot_config/hypr/hyprlock.conf.tmpl / hyprpaper.conf.tmpl).
.config/hypr/colors-grootshell.lua

# --- layer 3 — personal, withheld from guest installs (docs/track-E.md §2) -
# .chezmoiignore is always template-evaluated by chezmoi, no .tmpl suffix
# needed. A guest profile never sees these paths in `chezmoi managed`,
# `chezmoi diff`, or their $HOME. cs2-mode.sh is a CS2 FPS-tuning script —
# specific to my own game tweaks, not something a generic install should
# carry.
{{ if ne .profile "personal" -}}
bin/cs2-mode.sh
{{ end -}}
