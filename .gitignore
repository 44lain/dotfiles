# ---------------------------------------------------------------------------
# Deny by default.
#
# Everything is ignored. A file enters this repository only by being listed
# explicitly below, and only after being read. Treat this repo as public from
# commit zero — history does not erase cleanly.
# ---------------------------------------------------------------------------
*

# Allow git to descend into directories so the rules below can match at all.
!*/

# --- repository meta -------------------------------------------------------
!/.gitignore
!/.chezmoiignore
!/.chezmoi.toml.tmpl
!/README.md
!/Makefile
!/LICENSE

# --- CI ----------------------------------------------------------------------
!/.github/workflows/*.yml

# --- docs ------------------------------------------------------------------
!/docs/*.md
!/docs/superpowers/specs/*.md
!/docs/cursor-extensions.txt

# --- tests ---------------------------------------------------------------
!/test/*.sh
!/test/distro/*.sh

# --- shell -----------------------------------------------------------------
!/dot_bashrc.d/*.sh

# --- prompt ----------------------------------------------------------------
!/dot_config/starship.toml

# --- git -------------------------------------------------------------------
# user.name + LFS + an include of ~/.config/git/local (machine-local email,
# never tracked). See docs/track-E.md.
!/dot_gitconfig

# --- hypr ----------------------------------------------------------------
# Hyprland lua config + hypridle + the chezmoi-generated per-host machine
# data (docs/track-E.md §2). hyprlock.conf.tmpl / hyprpaper.conf.tmpl (wave
# 4) render the personal wallpaper path from wallpaper_path, kept
# machine-local — the templates themselves carry no personal data.
!/dot_config/hypr/hyprland.lua
!/dot_config/hypr/hypridle.conf
!/dot_config/hypr/hyprlock.conf.tmpl
!/dot_config/hypr/hyprpaper.conf.tmpl
!/dot_config/hypr/machine.lua.tmpl
# colors-grootshell.lua is generated by grootshell-theme from the wallpaper
# (see docs/hyprland-wallpaper-and-theming.md) — stays untracked.

# --- per-host machine data ------------------------------------------------
!/.chezmoidata/hosts.toml
!/.chezmoidata/packages.toml

# --- kitty ---------------------------------------------------------------
# The baseline only. colors-grootshell.conf is the matugen palette, generated
# per wallpaper and left untracked.
!/dot_config/kitty/kitty.conf

# --- yt-x --------------------------------------------------------------
# Terminal YouTube browser config. No secrets — cookies are read from the
# browser at runtime, never stored. See docs/yt-x.md for deps and the Zen
# profile symlink (not created by stow).
!/dot_config/yt-x/config.tmpl

# --- yazi --------------------------------------------------------------
# File-manager tweaks only. The `z`/`Z` keymap needs the zoxide and fzf yazi
# plugins: `ya pack -a yazi-rs/plugins:zoxide yazi-rs/plugins:fzf`.
!/dot_config/yazi/*.toml

# --- environment.d -------------------------------------------------------
# systemd --user PATH glue so uwsm-spawned apps see ~/.local/bin (matugen).
!/dot_config/environment.d/*.conf

# --- rice (the dotfiles command) + personal ~/.local/bin scripts -----
!/dot_local/bin/*

# --- personal ~/bin scripts -------------------------------------------
!/bin/executable_*.sh

# ---------------------------------------------------------------------------
# Hard re-ignore. These patterns come last so they win over every rule above,
# even if a file is moved into an allowed directory by mistake.
# ---------------------------------------------------------------------------
**/id_rsa*
**/id_ed25519*
**/id_ecdsa*
**/*.pem
**/*.key
**/*.p12
**/*.pfx
**/*.ovpn
**/*.kdbx
**/.env
**/.env.*
!**/.env.example
**/.netrc
**/credentials
**/hosts.yml
**/*token*
**/*secret*
**/.bash_history
**/known_hosts
**/mcp.json
