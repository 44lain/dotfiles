{{- /* wallpaper_path is optional (machine-local, ~/.config/chezmoi/chezmoi.toml
       [data]). Unset -> a plain dark background, so a first apply on a fresh
       machine works without asking for a wallpaper. */ -}}
{{- if .wallpaper_path -}}
$wallpaper = {{ .wallpaper_path }}

{{ end -}}
background {
    monitor =
{{- if .wallpaper_path }}
    path = $wallpaper
    blur_passes = 1
    blur_size = 4
{{- else }}
    color = rgba(1e1e2eff)
{{- end }}
}

input-field {
    monitor =
    size = 260, 50
    outline_thickness = 2
    dots_center = true
    fade_on_empty = false
    placeholder_text = <i>senha…</i>
    hide_input = false
    position = 0, -40
    halign = center
    valign = center
}

label {
    monitor =
    text = $TIME
    font_size = 64
    position = 0, 120
    halign = center
    valign = center
}

general {
    grace = 2
    hide_cursor = true
}
