{{- if not (hasKey .hosts .host) -}}
{{- fail (printf "host %q (from ~/.config/chezmoi/chezmoi.toml) has no [hosts.%s] entry in .chezmoidata/hosts.toml. Known hosts: %s. Add a block for %q there first — see docs/track-E.md §2 cookbook." .host .host (keys .hosts | join ", ") .host) -}}
{{- end -}}
-- GENERATED by chezmoi from .chezmoidata/hosts.toml (host = "{{ .host }}").
-- Edit .chezmoidata/hosts.toml, not this file — `rice apply` overwrites it
-- on every run. See docs/track-E.md §2.
return {
    kb_layout = "{{ (index .hosts .host).kb_layout }}",
    scale = {{ (index .hosts .host).scale }},
    monitors = {
{{- range (index .hosts .host).monitors }}
        { output = "{{ .output }}", mode = "{{ .mode }}", position = "{{ .position }}", scale = {{ .scale }} },
{{- end }}
    },
    gpu_env = {
{{- range $k, $v := (index .hosts .host).gpu_env }}
        {{ $k }} = "{{ $v }}",
{{- end }}
    },
}
