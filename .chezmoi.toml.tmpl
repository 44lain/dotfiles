{{/* Prompted once at `chezmoi init`, written to ~/.config/chezmoi/chezmoi.toml.
     See docs/track-E.md §2. Labels are deliberately long/explicit: most
     people apply this without ever opening the README, so the explanation
     has to live in the prompt itself. */ -}}
{{- /* .chezmoidata (the .hosts table) is not available yet at this stage
       of chezmoi init, so the host name can't be validated here — it's
       checked instead where it's actually used, in
       dot_config/hypr/machine.lua.tmpl, which fails with a clear message
       instead of chezmoi's default cryptic one if the host doesn't exist. */ -}}
{{- $profile := promptStringOnce . "profile" "profile 'guest' (recommended) applies only the shared rice — themes, keybinds, look & feel. 'personal' also pulls in scripts/secrets specific to the maintainer's own machines. [personal/guest]" "guest" -}}
{{- $host := promptStringOnce . "host" "host — picks monitor layout, keyboard layout and GPU env from .chezmoidata/hosts.toml. Only 'desktop' and 'pentest' exist right now; anything else needs a [hosts.<name>] block added there first (docs/track-E.md §2, cookbook). [desktop/pentest]" "desktop" -}}
[data]
    profile = {{ $profile | quote }}
    host    = {{ $host | quote }}
    {{/* Not prompted here — optional, left blank on purpose. Blank means
         hyprlock uses a plain dark background and hyprpaper draws nothing.
         Set it by hand or via `rice onboard`'s wallpaper prompt (machine-
         local, same treatment as the git email — never committed). */ -}}
    wallpaper_path = ""

[git]
    autoCommit = false
    autoPush = false
